<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/pageZoomBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/brand_surface"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/btnPrevPage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="@string/prev_page" />

        <TextView
            android:id="@+id/txtPageIndicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/brand_text"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnNextPage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_next"
            android:contentDescription="@string/next_page" />

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:layout_marginHorizontal="8dp"
            android:background="@color/brand_text_muted" />

        <ImageButton
            android:id="@+id/btnZoomOut"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_round_button"
            android:src="@drawable/ic_zoom_out"
            android:contentDescription="@string/zoom_out" />

        <ImageButton
            android:id="@+id/btnZoomIn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_round_button"
            android:src="@drawable/ic_zoom_in"
            android:contentDescription="@string/zoom_in" />

    </LinearLayout>

</merge>
